#!/usr/bin/env node
// Offline tmeet stand-in reporting a signed-in user.
const args = process.argv.slice(2).join(' ')
if (args !== 'auth status') {
  process.stderr.write(`unexpected tmeet arguments: ${args}\n`)
  process.exit(1)
}
process.stdout.write('Logged in\n  OpenId:  ou_snapshot\n  UserName:  快照用户\n')
