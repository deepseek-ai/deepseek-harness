{
  "name": "@deepseek-ai/satori-element",
  "description": "Element Manipulation",
  "version": "4.0.1-alpha.2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./jsx-runtime": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./jsx-dev-runtime": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src"
  ],
  "author": "Shigma <shigma10826@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "vendor/im/element"
  },
  "bugs": {
    "url": "https://github.com/satorijs/satori/issues"
  },
  "homepage": "https://satori.chat/",
  "keywords": [
    "satori",
    "element",
    "segment",
    "component",
    "message",
    "utilities"
  ],
  "dependencies": {
    "@deepseek-ai/cordis-element": "workspace:~",
    "@deepseek-ai/cosmokit": "workspace:~"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts"
}
