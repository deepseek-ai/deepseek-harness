{
  "name": "@deepseek-ai/cordis-plugin-im-markdown",
  "description": "GFM markdown for Satori messages: the `markdown` service that expands <markdown> while a message renders",
  "version": "4.0.0-alpha.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "vendor/plugin-im-markdown"
  },
  "keywords": [
    "satori",
    "markdown",
    "cordis"
  ],
  "cordis": {
    "service": {
      "implements": [
        "markdown"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-im-core": "workspace:~",
    "@deepseek-ai/satori-element": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-im-core": "workspace:~",
    "@deepseek-ai/satori-element": "workspace:~",
    "@types/mdast": "^4.0.4"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts"
}
