{
  "name": "@deepseek-ai/dsh-tencent-meeting-cli",
  "description": "Tencent Meeting through the official tmeet: the CLI by its absolute path, its skill, and account operations over Remote",
  "version": "0.2.2-rc.1",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/connector/tencent-meeting-cli"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "skills",
    "lib/types/**/*.d.ts",
