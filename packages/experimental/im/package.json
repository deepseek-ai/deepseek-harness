{
  "name": "@deepseek-ai/dsh-im",
  "description": "Platform-neutral IM host: intake, message store, im/message waterfall, hosted sessions, send funnel and output renderers",
  "version": "0.2.3-alpha.3",
  "publishConfig": {
    "access": "public"
  },
