# Copy to macos-signing.env with mode 0600; keep this directory outside the runner checkout.
DSH_DESKTOP_MACOS_SIGNING_IDENTITY=
DSH_DESKTOP_MACOS_TEAM_ID=
CSC_LINK=../certificates/developer-id.p12
CSC_KEY_PASSWORD=
# Configure exactly one notarization strategy; this template uses an App Store Connect API key.
APPLE_API_KEY=../certificates/notarization.p8
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
